# Server-side only — never shipped to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Vision model for the Stage 1 element analysis (default: claude-opus-5).
ANALYSIS_MODEL=claude-opus-5
# Thinking effort for the vision pass: low | medium | high (default: medium).
ANALYSIS_EFFORT=medium
# Vision calls allowed per minute per client IP (default: 15).
VISION_RATE_LIMIT_PER_MIN=15
# Set to 1 when running behind a reverse proxy so req.ip reflects the real client.
TRUST_PROXY=0

PORT=8787
