# Server-side only — never shipped to the browser.
#
# Provider A — Claude API (first-party):
ANTHROPIC_API_KEY=sk-ant-...
#
# Provider B — Claude on Vertex AI (Google Cloud). Leave ANTHROPIC_API_KEY unset, or force with CLAUDE_PROVIDER=vertex.
# The service account needs the Vertex AI User role and Claude models enabled in the project.
# CLAUDE_PROVIDER=vertex
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json   # project id is read from the key file
# VERTEX_PROJECT_ID=my-gcp-project                                  # optional override
# VERTEX_REGION=global                                              # or a specific region such as us-east5

# Vision model for the Stage 1 element analysis (default: claude-opus-5; same id on Vertex).
ANALYSIS_MODEL=claude-opus-5
# Thinking effort for the vision pass: low | medium | high (default: medium).
ANALYSIS_EFFORT=medium
# Vision calls allowed per minute per client IP (default: 15).
VISION_RATE_LIMIT_PER_MIN=15
# Set to 1 when running behind a reverse proxy so req.ip reflects the real client.
TRUST_PROXY=0

PORT=8787
